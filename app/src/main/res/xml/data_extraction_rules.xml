<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The WebView holds a signed-in YouTube session; keep it off the cloud. -->
        <exclude domain="file" path="app_webview" />
        <exclude domain="database" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="app_webview" />
    </device-transfer>
</data-extraction-rules>
